// use prisma-8

model User {
  id        Int      @id @default(autoincrement())
  email     String   @unique
  username  String?
  name      String?
  posts     Post[]
  streak    Int
  courses   Course[]
  createdAt TimestamptzString @default(now())
  updatedAt temporal.updatedAtString()
}

model Course {
  id                Int   @id @default(autoincrement())
  title             String
  users             User[]
  shortDescription  String
  longDescription   String
  lessons           Lesson[]
}

model Lesson {
  id          Int       @id @default(autoincrement())
  title       String    
  course      Course    @relation(fields: [lessonId], references: [id])
  lessonId    Int
}
