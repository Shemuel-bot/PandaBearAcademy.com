// use prisma-8

model User {
  id        Int      @id @default(autoincrement())
  email     String   @unique
  username  String?
  name      String?
  password  String
  streak    Int      @default(0)
  courses   Course[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Course {
  id                Int   @id @default(autoincrement())
  title             String
  users             User[]
  shortDescription  String
  longDescription   String
  lessons           Lesson[]
}

model Lesson {
  id          Int       @id @default(autoincrement())
  title       String    
  course      Course    @relation(fields: [courseId], references: [id])
  courseId    Int
  videoLink   String
  description String
  problems    Problems?
}

model Problems {
  id            Int     @id @default(autoincrement())
  questions     String[]
  answers       String[]
  problemId     Int     @unique
  lesson        Lesson  @relation(fields: [problemId], references: [id])
}
